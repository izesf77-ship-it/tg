# ==========================================================
#  Telegram Chat Constructor Bot — пример конфигурации
#  Скопируйте файл в .env и заполните своими значениями
#  cp .env.example .env
# ==========================================================

# --- Обязательное -----------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- База данных ------------------------------------------
# Путь к файлу SQLite (относительно корня проекта)
DB_PATH=data/bot.sqlite3

# --- Администраторы ---------------------------------------
# Telegram ID админов через запятую. Узнать свой ID: @userinfobot
ADMIN_IDS=123456789

# --- OpenRouter (необязательно) ---------------------------
# Если ключ не задан, AI-генерация сценариев отключается,
# остальные функции продолжают работать.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# --- Лимиты (могут меняться из админ-панели) ---------------
LIMITS_IMAGE_PER_HOUR=20
LIMITS_AI_PER_HOUR=5
LIMITS_IMAGE_PER_HOUR_PREMIUM=100
LIMITS_AI_PER_HOUR_PREMIUM=30
LIMITS_ACTIONS_PER_MINUTE=60
LIMITS_MAX_MESSAGES=200
LIMITS_MAX_CHATS=100

# --- Монетизация (Telegram Stars, заготовка) ---------------
# Пока платежи не подключены, флаг используется для демо-режима.
PREMIUM_ENABLED=false
PREMIUM_STARS_PRICE=250

# --- Рендерер ---------------------------------------------
# Каталог со шрифтами (README с инструкцией внутри)
FONTS_DIR=fonts
# Ширина итогового изображения в пикселях (0 = по умолчанию 1080)
RENDER_WIDTH=1080
# Максимальная высота изображения (0 = без ограничения)
RENDER_MAX_HEIGHT=20000

# --- Логирование -------------------------------------------
LOG_LEVEL=INFO
# Путь к файлу логов (пусто = только консоль)
LOG_FILE=

# --- Прочее ------------------------------------------------
# Текст рекламного сообщения для бесплатных пользователей
AD_TEXT=⭐️ Premium безлимитно генерирует переписки. Поддержать бота: /premium
